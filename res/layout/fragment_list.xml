<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header shown only when there are dictionaries -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/formats_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>

    <!-- Folder row, shown only above the bookmarks -->
    <LinearLayout
        android:id="@+id/folder_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- The padding is on the chips, inside what scrolls, or it would cut through the fade -->
        <HorizontalScrollView
            android:id="@+id/folder_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/folder_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.chip.Chip
            android:id="@+id/folder_menu"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/folders_list"
            app:chipEndPadding="12dp"
            app:chipIcon="@drawable/ic_keyboard_arrow_down"
            app:chipIconSize="24dp"
            app:chipStartPadding="12dp"
            app:iconEndPadding="0dp"
            app:iconStartPadding="0dp"
            app:textEndPadding="0dp"
            app:textStartPadding="0dp" />
    </LinearLayout>

    <itkach.aard2.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        tools:listitem="@layout/blob_descriptor_list_item"
        tools:visibility="gone" />

    <include layout="@layout/empty_view" />

</LinearLayout>
